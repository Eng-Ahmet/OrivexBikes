{
  "name": "qqbikes-management-system",
  "version": "1.0.0",
  "description": "QQBikes Rental & Store Management System - Node.js TypeScript MySQL Backend & Vanilla HTML/CSS/JS Frontend",
  "main": "backend/src/server.ts",
  "scripts": {
    "start": "tsx backend/src/server.ts",
    "dev": "tsx watch backend/src/server.ts",
    "test": "tsx backend/src/tests/index.test.ts",
    "build": "./node_modules/.bin/ng build && tsc",
    "build:frontend": "./node_modules/.bin/ng build",
    "build:backend": "tsc",
    "clean:rebuild": "bash scripts/clean-rebuild.sh"
  },
  "keywords": [
    "rental",
    "qqbikes",
    "pos",
    "express",
    "mysql",
    "typescript",
    "angular"
  ],
  "author": "",
  "license": "ISC",
