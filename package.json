{
  "name": "orivexbike-management-system",
  "version": "1.0.0",
  "description": "OrivexBike Rental & Store Management System - Node.js TypeScript MySQL Backend & Angular Modern PWA Frontend",
  "main": "backend/src/server.ts",
  "scripts": {
    "start": "npx tsx backend/src/server.ts",
    "dev": "npx tsx watch backend/src/server.ts",
    "test": "npx tsx backend/src/tests/index.test.ts",
    "build": "./node_modules/.bin/ng build && tsc",
    "build:frontend": "./node_modules/.bin/ng build",
    "build:backend": "tsc",
    "clean:rebuild": "bash scripts/clean-rebuild.sh"
  },
  "keywords": [
    "rental",
    "orivexbike",
    "orivex",
    "pos",
    "express",
    "mysql",
    "typescript",
    "angular"
  ],
  "author": "Orivex Technology S.L.",
  "license": "ISC",
  "dependencies": {
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/platform-browser-dynamic": "^22.1.3",
    "@angular/router": "^22.1.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "mysql2": "^3.24.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.0",
    "@types/serve-static": "^2.2.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "image-size": "^1.2.0",
    "uuid": "^11.1.0",
    "less": "^4.2.1"
  }
